# TiDB Cloud Cluster Credentials
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_user
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=test

# Server Configuration
PORT=5000
MAX_FILE_SIZE=262144000
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

JWT_SECRET=your_jwt_secret_here
CODE_HASH_SECRET=your_code_hash_secret_here

# Backblaze B2 Cloud Object Storage
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=secure-vault-files
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_app_key

# Brevo Email API (Sendinblue)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@gmail.com

# Google Gemini API (@google/genai)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Administrator Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
